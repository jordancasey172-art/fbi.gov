# ---------------------------------------------------------------------------
# All VITE_ values are PUBLIC: they are compiled into the browser bundle.
# Never put a secret key, service_role key, or database password here.
# Copy this file to .env.local (git-ignored) or set the same keys in Render.
# ---------------------------------------------------------------------------

# --- Live support queue (optional) -----------------------------------------
# Leave both blank to keep the same-browser local queue.
# Fill both in so visitors on any device reach one shared duty inbox.
# Use only a PUBLIC publishable key (sb_publishable_...) or legacy anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- AI-drafted triage replies (optional) ----------------------------------
# Any OpenAI-compatible POST /chat/completions endpoint.
# Without these, the built-in rule-based responder handles every conversation
# and no request leaves the browser.
# NOTE: a key placed here is visible to every visitor. Prefer a proxied
# endpoint that holds the real key server-side, with strict rate limits.
VITE_AI_ENDPOINT=
VITE_AI_API_KEY=
VITE_AI_MODEL=
